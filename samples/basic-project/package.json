    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@graphql-codegen/cli": "7.2.0",
    "@next/env": "^16.2.10",
