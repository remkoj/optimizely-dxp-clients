    "@remkoj/optimizely-graph-cli": "6.0.0",
    "@remkoj/optimizely-graph-functions": "6.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
