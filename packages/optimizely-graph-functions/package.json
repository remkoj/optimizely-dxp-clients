{
  "name": "@remkoj/optimizely-graph-functions",
  "repository": {
    "type": "git",
    "url": "https://github.com/remkoj/optimizely-dxp-clients.git",
    "directory": "packages/optimizely-graph-functions"
  },
  "bugs": "https://github.com/remkoj/optimizely-dxp-clients/issues",
  "author": "Remko Jantzen <693172+remkoj@users.noreply.github.com>",
  "homepage": "https://github.com/remkoj/optimizely-dxp-clients/blob/main/packages/optimizely-graph-functions/README.md",
  "version": "6.0.0-rc.4",
  "license": "Apache-2.0",
  "type": "commonjs",
  "description": "GraphQL Codegen preset for Optimizely Graph",
  "main": "./dist/index.js",
  "files": [
    "./dist",
    "./AGENTS.md"
  ],
  "bin": {
    "opti-patch": "dist/patch.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/index.js",
    "./preset": "./dist/preset.js",
    "./transform": "./dist/transform.js",
    "./documents": "./dist/documents/index.js",
    "./loader": "./dist/embedded-loader.js",
    "./contenttype-loader": "./dist/contenttype-loader.js",
    "./generate": "./dist/generator/index.js"
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "dist/index.d.ts"
      ],
      "preset": [
        "dist/preset.d.ts"
      ],
      "documents": [
        "dist/documents/index.d.ts"
      ],
      "transform": [
        "dist/transform.d.ts"
      ],
      "loader": [
        "./dist/embedded-loader.d.ts"
      ],
      "contenttype-loader": [
        "./dist/contenttype-loader.d.ts"
      ],
      "generate": [
        "./dist/generator/index.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@remkoj/optimizely-cms-api": "workspace:6.0.0-rc.4",
    "@remkoj/optimizely-graph-client": "workspace:6.0.0-rc.4",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/plugin-helpers": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@remkoj/optimizely-cms-api": "6.0.0-rc.4",
    "@remkoj/optimizely-graph-client": "6.0.0-rc.4",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-sock": "^1.0.1",
    "graphql-tag": "^2.12.7",
    "node-object-hash": "^3.1.1",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "prepare": "tsc --build",
    "recompile": "tsc --build --clean && tsc --build --force",
    "watch": "yarn tsc --watch",
    "opti-patch": "yarn node dist/patch.js"
  },
  "stableVersion": "5.2.0"
}
