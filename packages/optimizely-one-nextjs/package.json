    "watch-styles": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify --watch",
    "tailwind": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "recompile": "tsc --build --clean && tsc --build --force"
