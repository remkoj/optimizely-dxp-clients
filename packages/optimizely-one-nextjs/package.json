    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^11.0.0",
    "browserslist": "^4.28.6",
    "next": "^16.2.10",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "scheduler": "^0.27.0",
